    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract incoming payload from Supabase Webhook / Database Webhook / pg_net trigger\nconst body = $json.body || $json;\nconst record = body.record || body.new || body.data || {};\nconst metadata = record.raw_user_meta_data || record.user_metadata || {};\n\n// 1. Email extraction\nconst email = record.email || metadata.email || body.email || '';\n\n// 2. Name extraction (check full_name, name, first_name in metadata)\nlet name = metadata.full_name || metadata.name || metadata.first_name || '';\n\nif (!name && email) {\n  // Derive name from email prefix (e.g. john.doe@example.com -> John Doe)\n  const prefix = email.split('@')[0];\n  name = prefix\n    .replace(/[._-]/g, ' ')\n    .split(' ')\n    .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n    .join(' ');\n}\n\nif (!name) {\n  name = 'Valued User';\n}\n\n// 3. First name derivation for friendly greeting\nconst firstName = name.split(' ')[0] || 'there';\n\nreturn {\n  email: email,\n  name: name,\n  firstName: firstName,\n  userId: record.id || '',\n  createdAt: record.created_at || new Date().toISOString()\n};"
      },
      "id": "e4582f09-906d-491c-b2e1-4560d2b781a9",
      "name": "Extract User Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "welcome@upfiles.app",
        "toEmail": "={{ $json.email }}",
        "subject": "=Welcome to UpFiles, {{ $json.firstName }}! 🚀 Your cloud drive is ready",
        "html": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Welcome to UpFiles</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #0f172a; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #e2e8f0;\">\n  <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #0f172a; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"100%\" max-width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px; background-color: #1e293b; border-radius: 16px; overflow: hidden; border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\">\n          \n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #2563eb 0%, #3b82f6 50%, #1d4ed8 100%); padding: 36px 40px; text-align: center;\">\n              <div style=\"font-size: 28px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 6px;\">📁 UpFiles</div>\n              <div style=\"font-size: 14px; color: #bfdbfe; font-weight: 500;\">Secure Cloud Storage & File Sharing</div>\n            </td>\n          </tr>\n          \n          <!-- Main Body -->\n          <tr>\n            <td style=\"padding: 40px;\">\n              <h1 style=\"font-size: 22px; font-weight: 700; color: #f8fafc; margin-top: 0; margin-bottom: 16px;\">Welcome aboard, {{ $json.firstName }}! 🎉</h1>\n              <p style=\"font-size: 15px; line-height: 1.6; color: #94a3b8; margin-bottom: 24px;\">\n                Thank you for joining <strong style=\"color: #38bdf8;\">UpFiles</strong>. Your account (<code style=\"background-color: #0f172a; padding: 2px 6px; border-radius: 4px; color: #38bdf8; font-family: monospace;\">{{ $json.email }}</code>) is fully configured and ready to handle your files with peak speed and security.\n              </p>\n              \n              <!-- Feature Highlights Box -->\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #0f172a; border-radius: 12px; border: 1px solid #334155; margin-bottom: 28px;\">\n                <tr>\n                  <td style=\"padding: 24px;\">\n                    <div style=\"font-size: 14px; font-weight: 600; color: #e2e8f0; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px;\">Here is what you can do next:</div>\n                    <ul style=\"margin: 0; padding-left: 20px; color: #cbd5e1; font-size: 14px; line-height: 1.8;\">\n                      <li>⚡ <strong>Drag & Drop Uploads:</strong> Upload files and folders in seconds.</li>\n                      <li>🔗 <strong>Instant Sharing:</strong> Share password-protected & expiring links.</li>\n                      <li>⭐ <strong>Organize Easily:</strong> Star favorite files and group into custom folders.</li>\n                      <li>🔒 <strong>Bank-Grade Encryption:</strong> Your data remains protected 24/7.</li>\n                    </ul>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- CTA Button -->\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-bottom: 32px;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://upfiles.app\" target=\"_blank\" style=\"display: inline-block; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; padding: 14px 32px; border-radius: 8px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4); text-align: center;\">Go to Your Drive &rarr;</a>\n                  </td>\n                </tr>\n              </table>\n              \n              <p style=\"font-size: 14px; color: #64748b; line-height: 1.5; margin: 0;\">\n                If you have any questions or need assistance getting started, simply reply to this email or visit our help desk.\n              </p>\n            </td>\n          </tr>\n          \n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #0f172a; padding: 24px 40px; border-top: 1px solid #334155; text-align: center;\">\n              <p style=\"font-size: 12px; color: #64748b; margin: 0 0 8px 0;\">Sent with ❤️ by the UpFiles Team</p>\n              <p style=\"font-size: 11px; color: #475569; margin: 0;\">&copy; 2026 UpFiles. All rights reserved.</p>\n            </td>\n          </tr>\n          \n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {}
      },
